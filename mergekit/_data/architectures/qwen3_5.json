{
    "kind": "modular",
    "model_type": "qwen3_5",
    "architectures": [
        "Qwen3_5ForConditionalGeneration"
    ],
    "vocab_size_config_key": "vocab_size",
    "tagalong_files": [
        "preprocessor_config.json",
        "vocab.json"
    ],
    "modules": {
        "text_decoder": {
            "architecture": {
                "architectures": [
                    "Qwen3_5ForCausalLM"
                ],
                "model_type": "qwen3_5_text",
                "num_layers_config_key": "text_config.num_hidden_layers",
                "pre_weights": [
                    {
                        "name": "model.language_model.embed_tokens.weight",
                        "is_embed": true
                    }
                ],
                "post_weights": [
                    {
                        "name": "lm_head.weight",
                        "is_embed": true,
                        "optional": false
                    },
                    {
                        "name": "mtp.fc.weight",
                        "optional": true
                    },
                    {
                        "name": "mtp.layers.0.mlp.down_proj.weight",
                        "optional": true
                    },
                    {
                        "name": "mtp.layers.0.mlp.gate_proj.weight",
                        "optional": true
                    },
                    {
                        "name": "mtp.layers.0.mlp.up_proj.weight",
                        "optional": true
                    },
                    {
                        "name": "mtp.layers.0.self_attn.k_proj.weight",
                        "optional": true
                    },
                    {
                        "name": "mtp.layers.0.self_attn.q_proj.weight",
                        "optional": true
                    },
                    {
                        "name": "mtp.layers.0.self_attn.v_proj.weight",
                        "optional": true
                    },
                    {
                        "name": "mtp.layers.0.self_attn.o_proj.weight",
                        "optional": true
                    }
                ],
                "layer_templates": {
                    "weights": [
                        {
                            "name": "model.language_model.layers.${layer_index}.mlp.down_proj.weight"
                        },
                        {
                            "name": "model.language_model.layers.${layer_index}.mlp.gate_proj.weight"
                        },
                        {
                            "name": "model.language_model.layers.${layer_index}.mlp.up_proj.weight"
                        },
                        {
                            "name": "model.language_model.layers.${layer_index}.linear_attn.in_proj_a.weight",
                            "optional": true
                        },
                        {
                            "name": "model.language_model.layers.${layer_index}.linear_attn.in_proj_b.weight",
                            "optional": true
                        },
                        {
                            "name": "model.language_model.layers.${layer_index}.linear_attn.in_proj_qkv.weight",
                            "optional": true
                        },
                        {
                            "name": "model.language_model.layers.${layer_index}.linear_attn.in_proj_z.weight",
                            "optional": true
                        },
                        {
                            "name": "model.language_model.layers.${layer_index}.linear_attn.out_proj.weight",
                            "optional": true
                        },
                        {
                            "name": "model.language_model.layers.${layer_index}.self_attn.k_proj.weight",
                            "optional": true
                        },
                        {
                            "name": "model.language_model.layers.${layer_index}.self_attn.o_proj.weight",
                            "optional": true
                        },
                        {
                            "name": "model.language_model.layers.${layer_index}.self_attn.q_proj.weight",
                            "optional": true
                        },
                        {
                            "name": "model.language_model.layers.${layer_index}.self_attn.v_proj.weight",
                            "optional": true
                        }
                    ]
                }
            }
        }
    }
}
