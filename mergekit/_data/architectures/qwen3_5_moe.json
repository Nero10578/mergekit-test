{
    "kind": "modular",
    "model_type": "qwen3_5_moe",
    "architectures": [
        "Qwen3_5MoeForConditionalGeneration"
    ],
    "vocab_size_config_key": "vocab_size",
    "tagalong_files": [
        "preprocessor_config.json",
        "vocab.json"
    ],
    "modules": {
        "text_decoder": {
            "architecture": {
                "architectures": [
                    "Qwen3_5MoeForCausalLM"
                ],
                "model_type": "qwen3_5_moe_text",
                "num_layers_config_key": "text_config.num_hidden_layers",
                "pre_weights": [
                    {
                        "name": "model.language_model.embed_tokens.weight",
                        "is_embed": true
                    }
                ],
                "post_weights": [
                    {
                        "name": "lm_head.weight",
                        "is_embed": true,
                        "optional": false
                    },
                    {
                        "name": "mtp.fc.weight",
                        "optional": true
                    },
                    {
                        "name": "mtp.layers.0.mlp.experts.0.down_proj.weight",
                        "optional": true
                    },
                    {
                        "name": "mtp.layers.0.mlp.experts.0.gate_proj.weight",
                        "optional": true
                    },
                    {
                        "name": "mtp.layers.0.mlp.experts.0.up_proj.weight",
                        "optional": true
                    },
                    {
                        "name": "mtp.layers.0.mlp.experts.1.down_proj.weight",
                        "optional": true
                    },
                    {
                        "name": "mtp.layers.0.mlp.experts.1.gate_proj.weight",
                        "optional": true
                    },
                    {
                        "name": "mtp.layers.0.mlp.experts.1.up_proj.weight",
                        "optional": true
                    },
                    {
                        "name": "mtp.layers.0.mlp.shared_expert.down_proj.weight",
                        "optional": true
                    },
                    {
                        "name": "mtp.layers.0.mlp.shared_expert.gate_proj.weight",
                        "optional": true
                    },
                    {
                        "name": "mtp.layers.0.mlp.shared_expert.up_proj.weight",
                        "optional": true
                    },
                    {
                        "name": "mtp.layers.0.mlp.gate.weight",
                        "optional": true
                    },
                    {
                        "name": "mtp.layers.0.mlp.shared_expert_gate.weight",
                        "optional": true
                    },
                    {
                        "name": "mtp.layers.0.self_attn.k_proj.weight",
                        "optional": true
                    },
                    {
                        "name": "mtp.layers.0.self_attn.q_proj.weight",
                        "optional": true
                    },
                    {
                        "name": "mtp.layers.0.self_attn.v_proj.weight",
                        "optional": true
                    },
                    {
                        "name": "mtp.layers.0.self_attn.o_proj.weight",
                        "optional": true
                    }
                ],
                "layer_templates": {
                    "weights": [
                        {
                            "name": "model.language_model.layers.${layer_index}.mlp.gate.weight"
                        },
                        {
                            "name": "model.language_model.layers.${layer_index}.mlp.shared_expert_gate.weight"
                        },
                        {
                            "name": "model.language_model.layers.${layer_index}.mlp.shared_expert.down_proj.weight"
                        },
                        {
                            "name": "model.language_model.layers.${layer_index}.mlp.shared_expert.gate_proj.weight"
                        },
                        {
                            "name": "model.language_model.layers.${layer_index}.mlp.shared_expert.up_proj.weight"
                        },
                        {
                            "name": "model.language_model.layers.${layer_index}.mlp.experts.gate_up_proj"
                        },
                        {
                            "name": "model.language_model.layers.${layer_index}.mlp.experts.down_proj"
                        },
                        {
                            "name": "model.language_model.layers.${layer_index}.linear_attn.in_proj_a.weight",
